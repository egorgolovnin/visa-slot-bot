BOT_TOKEN=123456:ABC...            # от @BotFather
DATABASE_URL=postgresql://bot:PASSWORD@db:5432/visabot
ADMIN_IDS=111111111                # твой Telegram ID, через запятую если несколько
ADMIN_CHAT_ID=-1003979376615       # ID группы для алертов/аналитики/бэкапов (бот — админ группы). Пусто = в личку ADMIN_IDS
CHANNEL=@bestvisaeurope            # публичный канал для анонсов (бот — админ канала). Пусто = выключено
PROXY_URL=                         # http://user:pass@host:port — резидентный прокси для VFS
POLL_INTERVAL_SEC=600              # публичные данные VFS всё равно обновляются раз в 15–60 мин
MISSIONS=                          # пусто = бот сам найдёт страны; или hun,aut,fin
