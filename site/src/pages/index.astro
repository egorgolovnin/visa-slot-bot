---
import Base from '../layouts/Base.astro';
import Wheel from '../components/Wheel.astro';
import BotButton from '../components/BotButton.astro';
import Faq from '../components/Faq.astro';
import { PRICE, WHEEL, REFERRAL_PCT, BOT_COUNTRIES, BRAND, BOT_URL } from '../site';
import { FAQ_SERVICE } from '../faq-data';
import { getCollection } from 'astro:content';

const guides = (await getCollection('gid')).sort((a, b) => a.data.order - b.data.order).slice(0, 4);
const site = {
  '@context': 'https://schema.org', '@type': 'WebSite', name: BRAND, url: new URL('/', Astro.site).href,
  inLanguage: 'ru', publisher: { '@id': new URL('/#org', Astro.site).href },
};
const service = {
  '@context': 'https://schema.org', '@type': 'Service',
  name: 'Запись на подачу документов на шенгенскую визу с Кипра',
  serviceType: 'Помощь с записью в визовый центр', areaServed: { '@type': 'Country', name: 'Cyprus' },
  provider: { '@id': new URL('/#org', Astro.site).href }, url: BOT_URL,
  offers: [
    { '@type': 'Offer', name: 'Один человек', price: PRICE.person, priceCurrency: 'EUR' },
    { '@type': 'Offer', name: 'Семья: 2 взрослых и ребёнок', price: PRICE.family, priceCurrency: 'EUR' },
  ],
};
const steps = [
  { t: 'Заявка в боте', d: 'Команда /order: страна, удобные даты подачи и данные паспорта. Это занимает 2–3 минуты.' },
  { t: 'Ловим слот', d: 'Бот проверяет слоты каждую секунду, без перерыва. Подходящая дата появилась — записываем вас.' },
  { t: 'Подтверждение', d: 'Присылаем PDF с записью в бот. Только после этого выставляем счёт за сервис.' },
  { t: 'Подача', d: 'Приходите в назначенное время с документами. Список документов пришлём после выбора страны.' },
];
const why = [
  { t: 'Платите за результат', d: 'Счёт за сервис приходит после того, как запись уже сделана. Не нашли слот — вы ничего не платите.' },
  { t: 'Не нужно сидеть на сайте', d: 'Свободные даты появляются в разное время и быстро исчезают. Проверять сайт вручную больше не нужно.' },
  { t: 'Цена ниже, чем у перекупщиков', d: `${PRICE.person} € с человека, ${PRICE.family} € за семью из двух взрослых и ребёнка. Сборы консульства и визового центра не меняются.` },
  { t: 'Данные под защитой', d: 'Паспортные данные используем только для записи и храним в зашифрованном виде.' },
];
---
<Base
  title="Запись на шенгенскую визу с Кипра — Easy Visa"
  description={`Ловим свободный слот в визовом центре на Кипре и записываем вас. 15 стран, оплата ${PRICE.person} € только после брони. Колесо скидок в Telegram-боте.`}
  jsonLd={[site, service]}
>
  <section class="hero">
    <div class="wrap hero-in">
      <p class="eyebrow" data-reveal>Шенген с Кипра · без охоты за слотами</p>
      <h1 data-reveal data-reveal-delay="1">Укажите даты —<br />слот поймаем мы</h1>
      <p class="lead" data-reveal data-reveal-delay="2">
        Выберите страну и даты в Telegram-боте. Мы следим за визовыми центрами и записываем вас
        в первый подходящий слот. За сервис платите после брони: {PRICE.person} € с человека.
      </p>
      <div class="hero-ctas" data-reveal data-reveal-delay="3">
        <BotButton action="order" place="home_hero">Записаться в боте</BotButton>
        <BotButton action="wheel" place="home_hero" variant="ghost">Крутить колесо скидок</BotButton>
      </div>
      <ul class="hero-facts" data-reveal data-reveal-delay="3">
        <li><strong>15</strong><span>стран Шенгена доступно в боте</span></li>
        <li><strong>24/7</strong><span>ищем свободные слоты без перерыва</span></li>
        <li><strong>0 €</strong><span>вперёд за сервис — оплата после записи</span></li>
      </ul>
    </div>
    <div class="hero-fade" aria-hidden="true"></div>
  </section>

  <section class="section" aria-labelledby="how">
    <div class="wrap">
      <div class="section-head" data-reveal>
        <h2 id="how">Как это работает</h2>
        <p>Весь путь от заявки до готовой визы. Вся переписка — в Telegram.</p>
      </div>
      <ol class="steps">
        {steps.map((s, i) => (
          <li data-reveal data-reveal-delay={Math.min(i + 1, 3)}>
            <span class="s-num">{i + 1}</span>
            <h3>{s.t}</h3>
            <p>{s.d}</p>
          </li>
        ))}
      </ol>
      <div class="step-final" data-reveal>
        <span class="sf-num" aria-hidden="true">5</span>
        <div class="sf-body">
          <h3>Получение визы <span class="sf-emoji" aria-hidden="true">🎉</span></h3>
          <p>Вы подаёте документы, получаете паспорт с визой — и едете в путешествие. Ради этого момента всё и затевалось.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="wheel-band" aria-labelledby="wheel-h">
    <div class="wrap wheel-in">
      <div class="wheel-vis" data-reveal>
        <Wheel id="wheel-hero" />
      </div>
      <div class="wheel-copy" data-reveal data-reveal-delay="1">
        <p class="eyebrow">Бонус в боте</p>
        <h2 id="wheel-h">Колесо скидок: один шанс на каждого</h2>
        <p>Каждый пользователь бота может один раз покрутить колесо и получить скидку на сервис. Выпавшая скидка сама применится к вашей ближайшей заявке.</p>
        <p class="small band-note">Скидка уменьшает только оплату сервиса, не консульский сбор. Скидки не суммируются. <a href="/koleso-fortuny/">Все условия колеса</a></p>
        <BotButton action="wheel" place="home_wheel" variant="light">Открыть колесо в Telegram</BotButton>
      </div>
    </div>
  </section>

  <section class="section" aria-labelledby="why">
    <div class="wrap">
      <div class="section-head" data-reveal>
        <h2 id="why">Почему так удобнее</h2>
        <p>Прозрачная цена, никаких предоплат и ручного мониторинга.</p>
      </div>
      <div class="why">
        {why.map((w, i) => (
          <div class="ticket" data-reveal data-reveal-delay={Math.min(i + 1, 3)}>
            <h3>{w.t}</h3><p>{w.d}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="robin" aria-labelledby="robin">
    <div class="wrap robin-in" data-reveal>
      <span class="robin-badge" aria-hidden="true">🤝</span>
      <h2 id="robin">Мы за справедливость, а не за наживу</h2>
      <p>Сервис вырос из нашей же борьбы с перекупщиками, которые скупали слоты и перепродавали втридорога. Поэтому мы — как Робин Гуд: часть записей отдаём бесплатно. На колесе скидок можно выиграть запись за 0 €, а за приглашённых друзей — скидки вплоть до бесплатной.</p>
      <BotButton action="wheel" place="home_robin" variant="ghost">Испытать удачу на колесе</BotButton>
    </div>
  </section>

  <section class="section-tight" aria-labelledby="countries">
    <div class="wrap">
      <div class="section-head" data-reveal>
        <h2 id="countries">Страны, в которые записываем</h2>
      </div>
      <ul class="chips" data-reveal>{BOT_COUNTRIES.map((c) => <li>{c.name}</li>)}</ul>
      <p class="muted center" data-reveal>Где подавать, через какую систему идёт запись и что делать с Францией, Испанией и Италией, разобрано в разделе <a href="/strany/">«Куда и как подавать с Кипра»</a>.</p>
    </div>
  </section>

  <section class="section" aria-labelledby="ref">
    <div class="wrap">
      <div class="ref" data-reveal>
        <div>
          <h2 id="ref">Приведите друга и получите {REFERRAL_PCT}% на следующую запись</h2>
          <p>Отправьте другу личную ссылку из бота (команда /invite). Когда он оформит и оплатит запись, вам начислится скидка {REFERRAL_PCT}% на следующую заявку. Друзей может быть сколько угодно.</p>
          <p><a href="/referalnaya-programma/">Как работает реферальная программа</a></p>
        </div>
        <BotButton action="invite" place="home_ref" variant="ghost">Получить ссылку в боте</BotButton>
      </div>
    </div>
  </section>

  <section class="section-tight" aria-labelledby="guides">
    <div class="wrap">
      <div class="section-head" data-reveal>
        <h2 id="guides">Гид по шенгену с Кипра</h2>
      </div>
      <ul class="guide-list">
        {guides.map((g, i) => (
          <li data-reveal data-reveal-delay={Math.min(i + 1, 3)}><a href={`/gid/${g.id}/`}><span class="g-title">{g.data.title}</span><span class="g-desc">{g.data.description}</span></a></li>
        ))}
      </ul>
    </div>
  </section>

  <section class="section">
    <div class="wrap wrap-narrow" data-reveal><Faq items={FAQ_SERVICE} /></div>
  </section>

  <section class="final">
    <div class="wrap final-in" data-reveal>
      <h2>Укажите даты, а слот поймаем мы</h2>
      <p>Заявка займёт 2–3 минуты. Платите только после записи.</p>
      <BotButton action="order" place="home_final">Записаться в боте</BotButton>
    </div>
  </section>
</Base>

<style>
  /* Hero — Tesla-scale, centred, full first screen over a soft gradient */
  .hero { position: relative; min-height: min(92vh, 860px); display: flex; align-items: center; justify-content: center; text-align: center; background: var(--hero-bg); padding-block: clamp(4rem, 12vh, 8rem) clamp(3rem, 8vh, 6rem); overflow: hidden; }
  .hero-in { max-width: 56rem; }
  .hero h1 { font-size: var(--step-4); margin-bottom: 0.4em; }
  .lead { font-size: clamp(1.1rem, 1rem + 0.6vw, 1.5rem); color: var(--ink-2); max-width: 40rem; margin-inline: auto; }
  .hero-ctas { display: flex; flex-wrap: wrap; gap: 0.9rem; justify-content: center; margin: 2rem 0 0; }
  .hero-facts { list-style: none; padding: 0; margin: clamp(2.5rem, 6vw, 4rem) 0 0; display: flex; flex-wrap: wrap; justify-content: center; gap: clamp(1.5rem, 5vw, 4rem); }
  .hero-facts li { display: flex; flex-direction: column; gap: 0.2rem; max-width: 12rem; }
  .hero-facts strong { font: 650 clamp(2rem, 1.4rem + 2vw, 3rem)/1 var(--display); letter-spacing: -0.03em; color: var(--ink); }
  .hero-facts span { font-size: var(--step--1); color: var(--ink-2); line-height: 1.4; }
  .hero-fade { position: absolute; left: 0; right: 0; bottom: 0; height: 120px; background: linear-gradient(to bottom, transparent, var(--bg)); pointer-events: none; }
  @media (max-width: 520px) { .hero-facts { gap: 1.4rem 2.5rem; } .hero-facts li { max-width: 8rem; } }

  /* Steps */
  .steps { list-style: none; padding: 0; margin: 0; display: grid; grid-template-columns: repeat(4, 1fr); gap: clamp(1.2rem, 3vw, 2rem); }
  .steps li { text-align: left; }
  .s-num { display: inline-flex; align-items: center; justify-content: center; width: 2.6rem; height: 2.6rem; border-radius: 999px; background: var(--card-2); border: 1px solid var(--line); font: 650 1.1rem/1 var(--display); color: var(--brand); margin-bottom: 1rem; }
  .steps h3 { margin-bottom: 0.3em; }
  .steps p { color: var(--ink-2); margin: 0; font-size: var(--step--1); line-height: 1.55; }
  @media (max-width: 860px) { .steps { grid-template-columns: 1fr 1fr; gap: 2rem; } }
  @media (max-width: 480px) { .steps { grid-template-columns: 1fr; } }

  /* Step 5 — the happy pay-off, visually set apart */
  .step-final { display: flex; align-items: center; gap: 1.4rem; margin-top: clamp(1.5rem, 3vw, 2.2rem); padding: clamp(1.3rem, 3vw, 1.8rem) clamp(1.4rem, 4vw, 2.2rem); border-radius: var(--r-lg); background: linear-gradient(110deg, color-mix(in srgb, var(--brand) 16%, var(--bg)), color-mix(in srgb, var(--sun) 14%, var(--bg))); border: 1px solid color-mix(in srgb, var(--brand) 32%, transparent); }
  .sf-num { display: inline-flex; align-items: center; justify-content: center; flex: none; width: 3.1rem; height: 3.1rem; border-radius: 999px; background: var(--brand); color: #fff; font: 650 1.4rem/1 var(--display); box-shadow: 0 8px 22px rgba(23,128,61,0.3); }
  .sf-body h3 { margin: 0 0 0.25em; font-size: var(--step-2); }
  .sf-emoji { font-size: 1em; }
  .sf-body p { margin: 0; color: var(--ink-2); }
  @media (max-width: 480px) { .step-final { flex-direction: column; text-align: center; align-items: center; } }

  /* Robin Hood band */
  .robin { padding-block: clamp(3rem, 7vw, 5rem); }
  .robin-in { max-width: 44rem; margin-inline: auto; text-align: center; padding: clamp(2rem, 5vw, 3rem); border-radius: var(--r-lg); background: var(--card-2); border: 1px solid var(--line); box-shadow: var(--shadow); }
  .robin-badge { font-size: 2.4rem; display: block; margin-bottom: 0.6rem; }
  .robin-in h2 { margin-bottom: 0.4em; }
  .robin-in p { color: var(--ink-2); font-size: var(--step-1); margin-bottom: 1.6rem; }

  /* Wheel showcase — dark full-bleed panel */
  .wheel-band { background: #121417; color: #e8eaee; padding-block: clamp(3.5rem, 8vw, 6.5rem); }
  .wheel-in { display: grid; grid-template-columns: 0.95fr 1.05fr; gap: clamp(2rem, 6vw, 5rem); align-items: center; }
  .wheel-vis { display: flex; justify-content: center; }
  .wheel-band :global(.wheel) { color: #fff; }  /* panel is always dark: keep wheel labels light in both themes */
  .wheel-band h2 { color: #fff; }
  .wheel-copy p { color: #b7bcc4; }
  .wheel-copy .eyebrow { color: var(--sun); }
  .wheel-band a { color: #ffd34d; }
  .band-note { color: #9aa0a9 !important; }
  .wheel-copy .btn { margin-top: 0.5rem; }
  @media (max-width: 760px) { .wheel-in { grid-template-columns: 1fr; text-align: center; } .wheel-copy .chips, .wheel-copy { align-items: center; } .wheel-vis :global(.wheel) { width: min(78vw, 340px); } }

  /* Why */
  .why { display: grid; grid-template-columns: repeat(4, 1fr); gap: 1.2rem; }
  .why h3 { margin-bottom: 0.4em; }
  .why p { color: var(--ink-2); margin: 0; font-size: var(--step--1); line-height: 1.55; }
  @media (max-width: 900px) { .why { grid-template-columns: 1fr 1fr; } }
  @media (max-width: 520px) { .why { grid-template-columns: 1fr; } }

  /* Referral band */
  .ref { display: grid; grid-template-columns: 1fr auto; gap: 2.5rem; align-items: center; border-radius: var(--r-lg); padding: clamp(1.8rem, 5vw, 3rem); background: var(--card-2); border: 1px solid var(--line); box-shadow: var(--shadow); }
  .ref h2 { margin-bottom: 0.4em; }
  .ref p { color: var(--ink-2); max-width: 42rem; }
  @media (max-width: 760px) { .ref { grid-template-columns: 1fr; gap: 1.5rem; } }

  /* Guides */
  .guide-list { list-style: none; padding: 0; margin: 0; display: grid; grid-template-columns: 1fr 1fr; gap: 0; }
  .guide-list li:nth-child(odd) { border-right: 1px solid var(--line); }
  .guide-list a { display: grid; gap: 0.3rem; padding: 1.4rem clamp(0.5rem, 3vw, 2rem); border-top: 1px solid var(--line); text-decoration: none; color: var(--ink); transition: background-color 0.2s var(--ease); }
  .guide-list a:hover { background: var(--card-2); }
  .g-title { font-weight: 650; font-size: var(--step-1); letter-spacing: -0.015em; }
  .guide-list a:hover .g-title { color: var(--brand); }
  .g-desc { color: var(--ink-2); font-size: var(--step--1); }
  @media (max-width: 700px) { .guide-list { grid-template-columns: 1fr; } .guide-list li:nth-child(odd) { border-right: 0; } }

  /* Final CTA */
  .final { background: var(--hero-bg); border-top: 1px solid var(--line); }
  .final-in { padding-block: clamp(3.5rem, 9vw, 6rem); text-align: center; max-width: 46rem; }
  .final h2 { margin-bottom: 0.3em; }
  .final p { color: var(--ink-2); font-size: var(--step-1); margin-bottom: 2rem; }
</style>
