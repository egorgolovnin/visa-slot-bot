---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import BotButton from '../../components/BotButton.astro';
import Faq from '../../components/Faq.astro';
import { BRAND } from '../../site';

export async function getStaticPaths() {
  const all = (await getCollection('strany')).sort((a, b) => a.data.order - b.data.order);
  return all.map((entry) => ({ params: { slug: entry.id }, props: { entry, all } }));
}
const { entry, all } = Astro.props;
const { Content } = await render(entry);
const d = entry.data;
const url = new URL(`/strany/${entry.id}/`, Astro.site).href;
const fmt = (s: string) => new Date(s + 'T12:00:00Z').toLocaleDateString('ru-RU', { day: 'numeric', month: 'long', year: 'numeric' });

const article = {
  '@context': 'https://schema.org', '@type': 'Article', headline: d.seoTitle, description: d.description,
  dateModified: d.updated, inLanguage: 'ru', mainEntityOfPage: url,
  image: new URL('/og.png', Astro.site).href,
  author: { '@type': 'Organization', name: `Редакция ${BRAND}`, url: new URL('/o-proekte/', Astro.site).href },
  publisher: { '@id': new URL('/#org', Astro.site).href },
  citation: d.sources.map((s) => s.url),
};
const i = all.findIndex((e) => e.id === entry.id);
const related = [1, 2, 3].map((k) => all[(i + k) % all.length]).filter((e) => e && e.id !== entry.id);
---
<Base title={d.seoTitle} description={d.description} ogType="article" modified={d.updated} jsonLd={[article]}>
  <Breadcrumbs items={[{ name: 'Страны', href: '/strany/' }, { name: d.name, href: `/strany/${entry.id}/` }]} />
  <article class="wrap article">
    <header>
      <h1>{d.name}: виза с Кипра, запись и сборы</h1>
      <p class="meta small muted">Редакция {BRAND}. Данные проверены <time datetime={d.updated}>{fmt(d.updated)}</time></p>
    </header>

    <div class="facts">
      <dl>
        <div><dt>Где подавать</dt><dd>{d.system}, Никосия</dd></div>
        <div><dt>Консульский сбор</dt><dd>{d.consularFee}</dd></div>
        <div><dt>Сервисный сбор</dt><dd>{d.serviceFee}</dd></div>
        {d.represents && <div><dt>Представляет</dt><dd>{d.represents.join(', ')}</dd></div>}
      </dl>
    </div>

    <div class="prose"><Content /></div>

    <div class="cta-box">
      <p>Слот поймаем мы. За сервис платите после записи.</p>
      <BotButton action="order" place={`strany_${entry.id.slice(0, 18)}`}>Записаться на подачу</BotButton>
    </div>

    {d.faq && <Faq items={d.faq.map((f) => ({ q: f.q, a: `<p>${f.a}</p>` }))} />}

    <section class="sources" aria-labelledby="src-h">
      <h2 id="src-h">Источники</h2>
      <ol class="small">
        <li><a href={d.official.url} rel="noopener" target="_blank">{d.official.name}</a></li>
        {d.sources.map((s) => <li><a href={s.url} rel="noopener" target="_blank">{s.name}</a></li>)}
      </ol>
    </section>
  </article>

  <aside class="wrap related" aria-labelledby="rel-h">
    <h2 id="rel-h">Другие страны</h2>
    <ul>{related.map((r) => <li><a href={`/strany/${r.id}/`}>{r.data.name} — виза с Кипра</a></li>)}</ul>
    <p class="small"><a href="/strany/">Все страны и системы записи →</a></p>
  </aside>
</Base>
<style>
  .article { padding-block: 1.5rem 2rem; }
  .article header { max-width: 46rem; }
  .meta { margin-bottom: 1.5rem; }
  .facts { max-width: 46rem; margin: 0 0 2rem; padding: 1.2rem 1.4rem; background: var(--surface, #f4f6fb); border-radius: var(--r); }
  .facts dl { margin: 0; display: grid; gap: 0.6rem; }
  .facts dl > div { display: flex; justify-content: space-between; gap: 1rem; border-bottom: 1px solid rgba(0,0,0,.08); padding-bottom: 0.6rem; }
  .facts dl > div:last-child { border-bottom: 0; padding-bottom: 0; }
  .facts dt { font-weight: 600; }
  .facts dd { margin: 0; text-align: right; }
  .prose :global(p:first-of-type) { font-size: var(--step-1); }
  .cta-box { max-width: 42rem; margin: 2.5rem 0; padding: 1.4rem 1.5rem; background: var(--ink); color: #fff; border-radius: var(--r); display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 1rem; }
  .cta-box p { margin: 0; font-weight: 600; }
</style>
