---
import Doc from '../layouts/Doc.astro';
import Faq from '../components/Faq.astro';
import BotButton from '../components/BotButton.astro';
import { FAQ_SERVICE, FAQ_WHEEL, FAQ_REFERRAL } from '../faq-data';
---
<Doc title="Вопросы и ответы" seoTitle="Вопросы о записи на шенгенскую визу с Кипра — Easy Visa" path="/faq/"
  description="Ответы на частые вопросы: как работает запись через бота, сколько стоит, когда платить, как действуют колесо скидок и реферальная программа.">
  <Faq heading="Запись и оплата" items={FAQ_SERVICE} schema />
  <Faq heading="Колесо скидок" items={FAQ_WHEEL} />
  <Faq heading="Реферальная программа" items={FAQ_REFERRAL} />
  <p style="margin-top:2rem">Не нашли ответ? Напишите в поддержку прямо в боте командой /support.</p>
  <BotButton action="start" place="faq">Открыть бота</BotButton>
</Doc>
