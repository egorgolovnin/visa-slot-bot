---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import BotButton from '../components/BotButton.astro';
import { BOT_COUNTRIES, DIRECT_COUNTRIES, FACTS_CHECKED } from '../site';

const checked = new Date(FACTS_CHECKED + 'T12:00:00Z').toLocaleDateString('ru-RU', { day: 'numeric', month: 'long', year: 'numeric' });
// countries that have their own detail page, matched by display name
const pages = new Map((await getCollection('strany')).map((e) => [e.data.name, e.id]));
// countries covered on another country's page (the embassy that represents them on Cyprus)
const repPage: Record<string, string> = {
  'Нидерланды': 'germaniya', 'Бельгия': 'germaniya', 'Дания': 'germaniya',
  'Норвегия': 'germaniya', 'Исландия': 'germaniya', 'Люксембург': 'germaniya',
  'Чехия': 'slovakiya', 'Словения': 'slovakiya',
};
// where a country's row should link: its own page, or the page of the embassy that represents it
const linkFor = (c: { name: string }) =>
  pages.has(c.name) ? `/strany/${pages.get(c.name)}/`
  : repPage[c.name] ? `/strany/${repPage[c.name]}/`
  : null;
---
<Base
  title="Куда подавать на шенген с Кипра: 18 стран — Easy Visa"
  description="В какие страны Шенгена можно записаться на подачу с Кипра через Easy Visa и куда записываются напрямую — Франция, Испания, Италия. Список по странам со ссылками."
>
  <Breadcrumbs items={[{ name: 'Страны', href: '/strany/' }]} />
  <div class="wrap section-tight">
    <h1>Куда и как подавать на шенген с Кипра</h1>
    <p class="lead muted">Записываем на подачу документов в 15 стран Шенгена. Ещё в три страны записываются напрямую — показываем, как именно. Данные проверены {checked}.</p>

    <h2>Страны, в которые записывает бот</h2>
    <div class="table-scroll">
      <table>
        <thead><tr><th scope="col">Страна</th><th scope="col">Особенности</th></tr></thead>
        <tbody>
          {BOT_COUNTRIES.map((c) => {
            const href = linkFor(c);
            return (
              <tr>
                <th scope="row">{href ? <a href={href}>{c.name}</a> : c.name}</th>
                <td>{c.note ?? (href ? <a href={href}>Подробнее о записи →</a> : '—')}</td>
              </tr>
            );
          })}
        </tbody>
      </table>
    </div>
    <BotButton action="order" place="strany_table">Записаться в одну из этих стран</BotButton>

    <h2 class="mt">Куда записываются напрямую</h2>
    <p class="muted prose">В эти страны бот не записывает: у них своя система, и заявку подаёте вы сами.</p>
    <div class="table-scroll">
      <table>
        <thead><tr><th scope="col">Страна</th><th scope="col">Как записаться</th><th scope="col">Ссылка</th></tr></thead>
        <tbody>
          {DIRECT_COUNTRIES.map((c) => (
            <tr><th scope="row">{c.name}</th><td>{c.how}</td><td><a href={c.url} rel="noopener" target="_blank">{c.url.replace(/^(https?:\/\/|mailto:)/, '')}</a></td></tr>
          ))}
        </tbody>
      </table>
    </div>
    <p class="muted prose">Греция, Мальта и другие страны, которых нет в таблицах: бот пока в них не записывает. Порядок записи уточняйте на сайте консульства страны на Кипре.</p>

    <div class="prose">
      <h2 class="mt">Как выбрать страну</h2>
      <p>Подают в консульство главной страны поездки: где проведёте больше всего времени, а если везде поровну — в страну первого въезда. Подробно с примерами — в статье <a href="/gid/kuda-podavat-shengen-s-kipra/">«Куда подавать на шенген с Кипра»</a>. Сколько стоит подача в каждую страну, собрано в статье <a href="/gid/skolko-stoit-shengen-s-kipra/">о сборах</a>.</p>
    </div>
  </div>
</Base>
<style>
  .lead { font-size: var(--step-1); max-width: 44rem; }
  h2 { font-size: var(--step-2); margin-top: 2rem; }
  .mt { margin-top: 3rem; }
  td a { white-space: nowrap; }
</style>
