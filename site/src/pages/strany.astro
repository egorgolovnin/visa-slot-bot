---
import Base from '../layouts/Base.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import BotButton from '../components/BotButton.astro';
import { BOT_COUNTRIES, DIRECT_COUNTRIES, FACTS_CHECKED } from '../site';

const LINKS: Record<string, string> = {
  'Австрия': 'https://www.bmeia.gv.at/en/austrian-embassy-nicosia/travels-to-austria/entrance-and-residence/how-to-apply',
  'Венгрия': 'https://visa.vfsglobal.com/one-pager/hungary/cyprus/english/',
  'Словакия': 'https://www.mzv.sk/en/web/nikozia-en/services/visa-information/schengen-visa',
  'Хорватия': 'https://visa.vfsglobal.com/one-pager/croatia/cyprus/english/',
  'Финляндия': 'https://visa.vfsglobal.com/one-pager/Finland/Cyprus/English/',
  'Швеция': 'https://www.swedenabroad.se/en/about-sweden-non-swedish-citizens/cyprus/going-to-sweden/apply-for-a-visa/',
  'Германия': 'https://nikosia.diplo.de/cy-en/service/1672100-1672100',
  'Нидерланды': 'https://www.netherlandsworldwide.nl/visa-the-netherlands/schengen-visa/apply-cyprus',
};
const fallback = (c: (typeof BOT_COUNTRIES)[number]) =>
  c.system === 'VFS Global' ? 'https://visa.vfsglobal.com/' : LINKS['Германия'];
const checked = new Date(FACTS_CHECKED + 'T12:00:00Z').toLocaleDateString('ru-RU', { day: 'numeric', month: 'long', year: 'numeric' });
---
<Base
  title="Куда подавать на шенген с Кипра: 18 стран — Easy Visa"
  description="Через кого записываться на шенген на Кипре: VFS Global, посольство Германии, Франция, Испания, Италия. Таблица по странам со ссылками на официальные страницы."
>
  <Breadcrumbs items={[{ name: 'Страны', href: '/strany/' }]} />
  <div class="wrap section-tight">
    <h1>Куда и как подавать на шенген с Кипра</h1>
    <p class="lead muted">У каждой страны Шенгена на Кипре свой способ записи. Ниже — через кого идёт подача и где официальная информация. Данные проверены {checked}.</p>

    <h2>Страны, в которые записывает бот</h2>
    <div class="table-scroll">
      <table>
        <thead><tr><th scope="col">Страна</th><th scope="col">Где подаёте</th><th scope="col">Особенности</th><th scope="col">Официальная страница</th></tr></thead>
        <tbody>
          {BOT_COUNTRIES.map((c) => (
            <tr>
              <th scope="row">{c.name}</th>
              <td>{c.system === 'VFS Global' ? 'Визовый центр VFS Global, Никосия' : 'Посольство Германии, Никосия'}</td>
              <td>{c.note ?? '—'}</td>
              <td><a href={LINKS[c.name] ?? fallback(c)} rel="noopener" target="_blank">{LINKS[c.name] ? 'открыть' : c.system === 'VFS Global' ? 'сайт VFS' : 'посольство Германии'}</a></td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
    <BotButton action="order" place="strany_table">Записаться в одну из этих стран</BotButton>

    <h2 class="mt">Куда записываются напрямую</h2>
    <p class="muted prose">В эти страны бот не записывает: у них своя система, и заявку подаёте вы сами.</p>
    <div class="table-scroll">
      <table>
        <thead><tr><th scope="col">Страна</th><th scope="col">Как записаться</th><th scope="col">Ссылка</th></tr></thead>
        <tbody>
          {DIRECT_COUNTRIES.map((c) => (
            <tr><th scope="row">{c.name}</th><td>{c.how}</td><td><a href={c.url} rel="noopener" target="_blank">{c.url.replace(/^(https?:\/\/|mailto:)/, '')}</a></td></tr>
          ))}
        </tbody>
      </table>
    </div>
    <p class="muted prose">Греция, Мальта и другие страны, которых нет в таблицах: бот пока в них не записывает. Порядок записи уточняйте на сайте посольства страны на Кипре.</p>

    <div class="prose">
      <h2 class="mt">Как выбрать страну</h2>
      <p>Подают в консульство главной страны поездки: где проведёте больше всего времени, а если везде поровну — в страну первого въезда. Подробно с примерами — в статье <a href="/gid/kuda-podavat-shengen-s-kipra/">«Куда подавать на шенген с Кипра»</a>. Сколько стоит подача в каждую страну, собрано в статье <a href="/gid/skolko-stoit-shengen-s-kipra/">о сборах</a>.</p>
    </div>
  </div>
</Base>
<style>
  .lead { font-size: var(--step-1); max-width: 44rem; }
  h2 { font-size: var(--step-2); margin-top: 2rem; }
  .mt { margin-top: 3rem; }
  td a { white-space: nowrap; }
</style>
