---
import { botLink, type BotAction } from '../site';
interface Props { action: BotAction; place: string; variant?: 'primary' | 'ghost' | 'light'; class?: string }
const { action, place, variant = 'primary', class: cls = '' } = Astro.props;
const href = botLink(action, place);
---
<a class:list={['btn', `btn-${variant}`, cls]} href={href} rel="noopener" target="_blank"
  data-bot={action} data-place={place}>
  <svg viewBox="0 0 24 24" aria-hidden="true" fill="currentColor"><path d="M21.4 4.6 2.9 11.7c-1.3.5-1.3 1.2-.2 1.6l4.7 1.5 1.8 5.6c.2.6.4.8.9.8.4 0 .6-.2.9-.5l2.3-2.2 4.8 3.5c.9.5 1.5.2 1.7-.8l3.1-14.7c.3-1.3-.5-1.9-1.5-1.4ZM9.3 14.3l8.6-5.4c.4-.3.8-.1.5.2l-7.1 6.4-.3 3.2-1.7-4.4Z"/></svg>
  <slot />
</a>
