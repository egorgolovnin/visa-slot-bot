---
/** FAQ as plain HTML (details/summary) so the answers are readable without JS and by crawlers. */
interface Props { items: { q: string; a: string }[]; schema?: boolean; heading?: string }
const { items, schema = false, heading = 'Частые вопросы' } = Astro.props;
const hid = 'faq-' + [...heading].reduce((h, c) => (h * 31 + c.charCodeAt(0)) >>> 0, 7).toString(36);
const ld = { '@context': 'https://schema.org', '@type': 'FAQPage',
  mainEntity: items.map((it) => ({ '@type': 'Question', name: it.q, acceptedAnswer: { '@type': 'Answer', text: it.a.replace(/<[^>]+>/g, '') } })) };
---
<section class="faq" aria-labelledby={hid}>
  <h2 id={hid}>{heading}</h2>
  {items.map((it) => (
    <details>
      <summary>{it.q}</summary>
      <div class="faq-a" set:html={it.a} />
    </details>
  ))}
</section>
{schema && <script type="application/ld+json" set:html={JSON.stringify(ld)} />}
<style>
  .faq { max-width: 46rem; }
  .faq + .faq { margin-top: 2.5rem; }
  details { border-top: 1px solid var(--line); }
  details:last-of-type { border-bottom: 1px solid var(--line); }
  summary { cursor: pointer; list-style: none; padding: 1.1rem 2.4rem 1.1rem 0; font-weight: 600; position: relative; }
  summary::-webkit-details-marker { display: none; }
  summary::after { content: '+'; position: absolute; right: 0.4rem; top: 0.9rem; font: 500 1.5rem/1 var(--display); color: var(--stamp); }
  details[open] summary::after { content: '−'; }
  .faq-a { padding: 0 0 1.2rem; color: var(--ink-2); max-width: 40rem; }
  .faq-a :global(p:last-child) { margin-bottom: 0; }
</style>
